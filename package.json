{
  "name": "server-civilization",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "predev": "pnpm --filter './packages/**' build",
    "dev": "concurrently -n API,ACTIVITY,BOT -c blue,yellow,green \"pnpm --filter api dev\" \"pnpm --filter activity dev\" \"pnpm --filter bot dev\"",
    "test": "pnpm -r test",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "db:generate": "pnpm --filter db generate",
    "db:migrate": "pnpm --filter db migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.20.0",
    "concurrently": "^9.1.2",
    "eslint": "^9.20.1",
    "prettier": "^3.5.1",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
