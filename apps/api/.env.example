NODE_ENV=development
PORT=3001

DB_HOST=localhost
DB_PORT=5432
DB_USER=server_civilization
DB_PASSWORD=server_civilization
DB_NAME=server_civilization

DISCORD_CLIENT_ID=your_discord_app_client_id
DISCORD_CLIENT_SECRET=your_discord_app_client_secret
DISCORD_OAUTH_REDIRECT_URI=https://your-app-id.discordsays.com/.proxy/auth/callback

SESSION_SECRET=generate_a_random_32+_character_string

# Comma-separated list of additional origins allowed by CORS.
# The default dev origin (http://localhost:5173) is always allowed in development.
ACTIVITY_ALLOWED_ORIGINS=https://*.discordsays.com
